# =============================================================================
# CodeAlpha Task 4 — Custom Local Detection Rules
# =============================================================================
# These rules are intentionally scoped to SAFE, SELF-GENERATED test traffic
# inside a local lab (see scripts/generate_test_traffic.py). They are written
# for demonstration/education, not as a general-purpose threat feed.
#
# Suricata rule syntax reminder:
#   action proto src_ip src_port -> dst_ip dst_port (options)
#
# SID numbering: we use the 1000000+ range reserved for local/custom rules,
# as recommended by Suricata/Snort conventions.
# =============================================================================

# -----------------------------------------------------------------------------
# RULE 1 — ICMP Test Traffic
# Detects ICMP echo requests (ping) generated by our own test script against
# the local lab target. Demonstrates basic protocol-level detection.
# -----------------------------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"CODEALPHA TEST ICMP Probe Detected"; itype:8; sid:1000001; rev:1; classtype:attempted-recon; priority:3; metadata:severity Medium;)

# -----------------------------------------------------------------------------
# RULE 2 — Suspicious HTTP Request Pattern
# Detects a clearly artificial test request (a custom header/URI our script
# sends) to a local test HTTP server. Demonstrates application-layer
# (HTTP) content matching.
# -----------------------------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"CODEALPHA TEST Suspicious HTTP Request Pattern"; flow:established,to_server; http.uri; content:"/codealpha-test-suspicious"; nocase; sid:1000002; rev:1; classtype:web-application-attack; priority:2; metadata:severity High;)

# -----------------------------------------------------------------------------
# RULE 3 — Port Scanning Pattern
# Detects a burst of connection attempts from one source to many destination
# ports on the lab host in a short window — a simplified port-scan signature.
# -----------------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"CODEALPHA TEST Possible Port Scan Detected"; flags:S; flow:stateless; threshold:type threshold, track by_src, count 10, seconds 5; sid:1000003; rev:1; classtype:attempted-recon; priority:2; metadata:severity High;)

# -----------------------------------------------------------------------------
# RULE 4 — Suspicious Authentication Test Pattern
# Detects a controlled sequence of failed login attempts against a
# deliberately created local test service (scripts/generate_test_traffic.py
# --login-test posts to a local Flask test endpoint with a custom header).
# -----------------------------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"CODEALPHA TEST Repeated Failed Login Attempts"; flow:established,to_server; http.uri; content:"/codealpha-test-login"; nocase; http.method; content:"POST"; threshold:type threshold, track by_src, count 5, seconds 10; sid:1000004; rev:1; classtype:attempted-user; priority:1; metadata:severity Critical;)

# -----------------------------------------------------------------------------
# RULE 5 — Custom CodeAlpha Proof-of-Life Test Signature
# A unique, completely harmless signature used purely to prove end-to-end
# that the pipeline (traffic -> Suricata -> eve.json -> DB -> dashboard)
# works. Triggered with: generate_test_traffic.py --signature
# -----------------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"CODEALPHA TEST Proof-of-Life Signature Triggered"; content:"CODEALPHA-IDS-TEST-SIGNATURE"; sid:1000005; rev:1; classtype:not-suspicious; priority:4; metadata:severity Low;)
